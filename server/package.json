{
  "name": "@orderflow/server",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "node --watch src/server.js",
    "start": "node src/server.js",
    "db:generate": "node --env-file-if-exists=../.env ../node_modules/prisma/build/index.js generate",
    "db:migrate": "node --env-file-if-exists=../.env ../node_modules/prisma/build/index.js migrate dev",
    "db:deploy": "node --env-file-if-exists=../.env ../node_modules/prisma/build/index.js migrate deploy",
    "db:seed": "node --env-file-if-exists=../.env prisma/seed.js",
    "test": "vitest run",
    "test:unit": "vitest run tests/unit",
    "test:integration": "vitest run tests/integration",
    "lint": "eslint ."
  },
  "prisma": { "seed": "node prisma/seed.js" },
  "dependencies": {
    "@prisma/client": "^6.18.0",
    "argon2": "^0.44.0",
    "cookie": "^1.0.2",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.5",
    "express": "^5.1.0",
    "express-rate-limit": "^8.1.0",
    "dotenv": "^16.6.1",
    "helmet": "^8.1.0",
    "pino": "^9.13.0",
    "pino-http": "^10.5.0",
    "socket.io": "^4.8.1",
    "zod": "^4.1.12"
  },
  "devDependencies": {
    "@eslint/js": "^9.38.0",
    "eslint": "^9.38.0",
    "prisma": "^6.18.0",
    "supertest": "^7.1.4",
    "vitest": "^5.1.0"
  }
}
